# Required for the admin dashboard
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=paste-a-random-string-of-at-least-32-characters

# Your public address (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Added automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=

# Optional: e-mail notification for each contact message (resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
